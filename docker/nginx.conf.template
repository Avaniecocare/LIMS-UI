server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  # Strict CSP. No inline scripts: config.js is a same-origin file generated at start.
  set $csp "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${API_URL} ${STORAGE_ORIGIN}; font-src 'self'; connect-src 'self' ${API_URL}; media-src 'self' blob:; frame-src ${API_URL} ${STORAGE_ORIGIN}; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'";

  # Server-level copy for responses no location handles (e.g. internal errors). Each location
  # below includes the same file, because a location's own add_header cancels inheritance.
  include /etc/nginx/snippets/security-headers.conf;

  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }
  location = /config.js {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
    try_files $uri =404;
  }
  # The service worker and the manifest must always be fresh, so a release reaches installed apps.
  location ~ ^/(sw\.js|manifest\.webmanifest)$ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
  }
  location = /healthz {
    include /etc/nginx/snippets/security-headers.conf;
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
